VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# VITE_SUPABASE_ANON_KEY is also supported for compatibility.

# Server-only Vercel environment variables (never prefix these with VITE_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
# Optional; defaults to openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b
RESEND_API_KEY=YOUR_RESEND_API_KEY
SUPPORT_ADMIN_EMAIL=developer@example.com
# Optional sender; configure a verified domain in Resend for production
SUPPORT_EMAIL_FROM=WiseProfit Support <support@example.com>
